// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define WORK    0
#define ORBIT   1
#define NEBULA  2
#define HORIZON 3

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <220>;
    retro-tap;
};

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.

    behaviors {
        lt_rpt: layer_tap_repeat {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <220>;
            retro-tap;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        del_to_begin: m1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(HOME) &kp DELETE>;
            label = "M1";
        };

        del_to_end: del_to_end {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(END) &kp DELETE>;
            label = "DEL_TO_END";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WORK {
            display-name = "Work Layer";

            // ------------------------------------------------------------------------------------------------------------
            // | ESC |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |BSPC |
            // |  CAPS |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |    \    |
            // |  SHIFT  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  | SHIFT |
            // |  CTRL |LMETA|  ALT  |   SPACE   |     SPACE     | Raise |RMETA|  CTRL |

            bindings = <
                &kp ESC             &kp Q     &kp W      &kp E      &kp R       &kp T      &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSLH
                &lt_rpt NEBULA TAB  &kp A     &kp S      &kp D      &kp F       &kp G      &kp H      &kp J  &kp K      &kp L    &lt_rpt HORIZON ENTER
                &kp LSHIFT          &kp Z     &kp X      &kp C      &kp V       &kp B      &kp N      &kp M  &kp COMMA  &kp DOT  &kp RSHIFT
                &kp LCTRL           &kp LALT  &kp LMETA  &kp SPACE  &mo ORBIT   &kp RCTRL  &kp RMETA  &kp RALT
            >;
        };

        ORBIT {
            display-name = "ORBIT";

            // ------------------------------------------------------------------------------------------------------------
            // | ESC |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |BSPC |
            // |  CAPS |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |    \    |
            // |  SHIFT  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  | SHIFT |
            // |  CTRL |LMETA|  ALT  |   SPACE   |     SPACE     | Raise |RMETA|  CTRL |

            bindings = <
                &kp GRAVE  &kp N1  &kp N2  &kp N3          &kp N4         &kp N5        &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
                &trans     &trans  &trans  &kp DEL         &kp LC(RIGHT)  &trans        &kp BSPC  &trans    &kp UP    &trans     &trans
                &trans     &trans  &trans  &trans          &trans         &kp LC(LEFT)  &trans    &kp LEFT  &kp DOWN  &kp RIGHT  &trans
                &trans     &trans  &trans  &kp LEFT_SHIFT  &trans         &trans        &trans    &trans
            >;
        };

        NEBULA {
            display-name = "NEBULA";

            bindings = <
                &trans  &trans    &trans  &kp END         &trans          &trans          &trans          &trans           &kp MINUS  &kp EQUAL     &kp UP    &trans
                &trans  &kp HOME  &trans  &kp DEL         &kp RIGHT       &trans          &kp BSPC        &kp LBKT         &kp RBKT   &kp SEMI      &kp APOS
                &trans  &trans    &trans  &kp LC(INSERT)  &kp LS(INSERT)  &kp LEFT        &kp DOWN        &kp C_MENU       &trans     &mmv MOVE_UP  &kp FSLH
                &trans  &trans    &trans  &kp LSHFT       &trans       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
            >;
        };

        HORIZON {
            display-name = "HORIZON";

            bindings = <
                &trans  &kp F1          &kp F2      &kp F3  &kp F4       &kp F5        &kp F6           &kp F7      &kp F8     &kp F9     &kp F10  &trans
                &trans  &del_to_begin   &trans      &trans  &del_to_end  &kp C_PREV    &kp C_PP         &kp C_NEXT  &kp F11    &kp F12    &trans
                &trans  &trans          &trans      &trans  &trans       &kp C_VOL_DN  &kp C_VOLUME_UP  &kp K_MUTE  &kp PG_DN  &kp PG_UP  &kp INSERT
                &trans  &sys_reset      &trans      &trans  &studio_unlock  &trans     &kp BSPC         &kp DEL
            >;
        };
    };
};
