# This file was generated from a template. Edit it to match your keyboard.
# See https://docs.zephyrproject.org/4.1.0/hardware/porting/board_porting.html#write-kconfig-files
# for more information.

# Enable MPU
CONFIG_ARM_MPU=y

# Enable GPIO
CONFIG_GPIO=y
CONFIG_NFCT_PINS_AS_GPIOS=n

# Enable pinctrl
CONFIG_PINCTRL=y

# Place application at &code_partition address
CONFIG_USE_DT_CODE_PARTITION=y

# Generate a .uf2 firmware image
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Uncomment this if not using an external 32 kHz crystal
# CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# Disable BLE, purely USB
CONFIG_ZMK_BLE=n
CONFIG_BT=n
CONFIG_ZMK_USB=y
CONFIG_USB_HID_POLL_INTERVAL_MS=1

CONFIG_LED=y
CONFIG_LED_GPIO=y
CONFIG_I2C=y
CONFIG_SENSOR=y
CONFIG_ZMK_MAX17048=y
CONFIG_ZMK_BATTERY_REPORTING=y

CONFIG_ZMK_PM_SOFT_OFF=y
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_USB_LOGGING=n
CONFIG_BDKB_BATTERY_STATUS_LEDS=n
CONFIG_BDKB_SP3T_MODE_SWITCH=n

CONFIG_ZMK_KSCAN_DEBOUNCE_PRESS_MS=1
CONFIG_ZMK_KSCAN_DEBOUNCE_RELEASE_MS=20

CONFIG_WARN_DEPRECATED=n
CONFIG_WARN_EXPERIMENTAL=n
